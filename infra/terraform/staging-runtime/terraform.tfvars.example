aws_region     = "ap-southeast-2"
domain_name    = "fp-staging.tonimakes.com"
desired_count  = 0
task_cpu       = 256
task_memory    = 512

# Fill these references from staging-base Terraform outputs. Do not paste secret values here.
hosted_zone_id = "Z0123456789EXAMPLE"
certificate_arn = "arn:aws:acm:ap-southeast-2:123456789012:certificate/replace-me"
ecs_execution_role_arn = "arn:aws:iam::123456789012:role/feedbackport-staging-ecs-execution"
ecs_task_role_arn = "arn:aws:iam::123456789012:role/feedbackport-staging-ecs-task"
runtime_secret_arns = {
  SUPABASE_SERVICE_ROLE_KEY = "arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:feedbackport/staging/SUPABASE_SERVICE_ROLE_KEY-example"
  TURNSTILE_SECRET_KEY = "arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:feedbackport/staging/TURNSTILE_SECRET_KEY-example"
  UPSTASH_REDIS_REST_URL = "arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:feedbackport/staging/UPSTASH_REDIS_REST_URL-example"
  UPSTASH_REDIS_REST_TOKEN = "arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:feedbackport/staging/UPSTASH_REDIS_REST_TOKEN-example"
}
