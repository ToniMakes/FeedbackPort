# Copy to .env for `docker compose up --build`. Never commit the real file.

# Public values (compiled into the browser bundle at build time)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare's always-pass test key; use your own site key in production
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Server-side secrets (runtime only)
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare's always-pass test secret; use your own secret key in production
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: tenant used when the request host has no <slug>.board. prefix
DEFAULT_TENANT_SLUG=demo
